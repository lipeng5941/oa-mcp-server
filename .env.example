# ============ 统一认证版（2.0.0）环境变量模板 ============
# 复制为 .env 并填写。密钥类值（服务 JWT）必须经密钥托管注入，禁止把真实值提交到仓库。

# --- 服务 ---
MCP_PORT=3000
MCP_PUBLIC_URL=https://oa-mcp-test.sgscf.cn
# 监听地址：仅允许 127.0.0.1（默认，回环）或 0.0.0.0（对外暴露需单独审批）。
# 不设 = 127.0.0.1；非法值启动即失败，不会被静默当成 0.0.0.0。
MCP_BIND_ADDR=127.0.0.1
# oidc = 方案A（JWT+JWKS 验签）；oauth2-userinfo = 方案A'（opaque + userinfo 校验）
AUTH_MODE=oauth2-userinfo

# --- MaxKey（统一认证） ---
MAXKEY_ISSUER=https://pttest.sgscf.com/sign
MAXKEY_AUTHORIZE_URL=https://pttest.sgscf.com/sign/authz/oauth/v20/authorize
MAXKEY_TOKEN_URL=https://pttest.sgscf.com/sign/authz/oauth/v20/token
MAXKEY_USERINFO_URL=https://pttest.sgscf.com/sign/api/oauth/v20/me
# 方案A 必填（管理员提供）；方案A' 留空
MAXKEY_JWKS_URL=
# MaxKey 注册的应用 ID（管理员注册后提供）
MCP_CLIENT_ID=
# 令牌 audience，默认等于 MCP_CLIENT_ID
MAXKEY_AUDIENCE=

# --- 员工编号 Claim（以 MaxKey Claim Mapper 配置为准，M15~M17） ---
EMPLOYEE_NO_CLAIM=employeeNumber
# 缺 Claim 时是否退回 sub（默认 false）
EMPLOYEE_NO_FALLBACK_SUB=false

# --- OA 内部适配层（仅内网；adapter 模式必填） ---
OA_ADAPTER_URL=http://内网地址/oa-adapter
# 服务间 JWT：密钥托管注入，禁止明文入库
OA_ADAPTER_SERVICE_JWT=

# --- 台账数据来源 ---
# adapter（默认）= 实时 OA 适配层，按员工行级权限查；snapshot = 本地快照（非实时），仅内网验收/联调用。
# snapshot 必须显式设置，配置不会自动回退；snapshot 下 OA_ADAPTER_* 不参与（无需填服务 JWT）。
LEDGER_DATA_MODE=adapter
# 快照文件：repair-ledger-data 产出的 current.json（只读）。仅 snapshot 模式读取。
LEDGER_SNAPSHOT_PATH=./data/current.json
# snapshot 模式行级权限夹具（必填，fail-closed）：{"schemaVersion":1,"employees":{"<员工编号>":["<actbasid>",...]}}
# 未列出的员工返回 403；该文件只代行 OA 行级权限，字段口径待 G-8 裁决，不得当作生产 ACL。
LEDGER_SNAPSHOT_ACL_PATH=

# --- 审计与限流 ---
AUDIT_LOG_PATH=./logs/audit.log
# 员工编号哈希盐（随机长字符串）
AUDIT_HASH_SALT=
RATE_LIMIT_RPS=10

# --- 其它 ---
CORS_ALLOWED_ORIGINS=
USERINFO_TOKEN_METHOD=bearer
USERINFO_CACHE_TTL_MS=60000
OA_ADAPTER_TIMEOUT_MS=30000
# 在投业务台账全量取数：单次最多 10000 行，上游每页最多 200 行
LEDGER_EXPORT_MAX_ROWS=10000
LEDGER_EXPORT_PAGE_SIZE=200
CLOCK_SKEW_SEC=30
# stdio 仅限本地开发联调（生产禁用）
STDIO_ENABLED=false
STDIO_DEV_EMPLOYEE_NO=

# ============ 已废弃（禁止再使用） ============
# OA_COOKIE / MCP_API_KEYS / SSO_URL —— 共享静态凭据体系已废弃
# WebBridge(127.0.0.1:10086) 会话桥已移除
